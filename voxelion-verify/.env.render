# ─────────────────────────────────────────────────────────────────────
#  Render environment — import via Render Dashboard → Environment →
#  "Add from .env" (paste this whole file, then fix the TODO values).
# ─────────────────────────────────────────────────────────────────────

APP_NAME=Voxelion
# local keeps /dev/handoff alive so the demo journey is clickable.
# Switch to production only once a real OpinionPadi signer exists.
APP_ENV=local
APP_DEBUG=false
APP_URL=https://TODO-your-service-name.onrender.com
APP_KEY=base64:jCLVtglUS8qzaqiYB85AceehfeDWYA7ETZ3Ff+pINV4=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=info

# ── Option A: SQLite (default — zero-config demo, data resets on redeploy)
DB_CONNECTION=sqlite

# ── Option B: Render PostgreSQL (recommended — persistent). Uncomment
#    and fill in from your Render Postgres dashboard "Connection Details":
# DB_CONNECTION=pgsql
# DB_HOST=TODO
# DB_PORT=5432
# DB_DATABASE=TODO
# DB_USERNAME=TODO
# DB_PASSWORD=TODO

# Cookie sessions — works on a single free instance without a disk.
SESSION_DRIVER=cookie
SESSION_ENCRYPT=true
SESSION_LIFETIME=120

QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Log mailer writes verification codes to the Render logs (viewable in
# dashboard → Logs). Swap to a real SMTP provider for production.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME=Voxelion

VITE_APP_NAME=Voxelion

# OpinionPadi integration — demo values; replace with real credentials
# for a genuine partner integration.
OPINIONPADI_ISSUER=opinionpadi
OPINIONPADI_API_TOKEN=op-dev-token
OPINIONPADI_WEBHOOK_SECRET=dev-webhook-secret
# OPINIONPADI_DASHBOARD_URL=
# OPINIONPADI_WEBHOOK_URL=

VERIFICATION_PROVIDER=voxelion
VERIFICATION_SESSION_TTL=60
COMPLETION_CODE_TTL=72
PHOTO_MAX_RETRIES=3
LIVENESS_MAX_RETRIES=3
SIMILARITY_THRESHOLD=0.80
CONSENT_VERSION=v1.0-draft
EMAIL_DNS_CHECK=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=TODO-change-me

TRUSTED_PROXIES=*
